<?xml version="1.0" encoding="utf-8"?>
<!-- SentisRender: Instance\SentisRender.cfg. Создаётся при первом запуске со значениями по умолчанию. -->
<RenderConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Отправлять ли фигуры и уведомления клиентскому моду. Выключено — вызовы других плагинов ничего не делают.
       Действует со следующего запуска сервера. -->
  <Enabled>true</Enabled>

  <!-- Как часто (мс) заново решать, кому что показывать, если ничего не менялось: фигуры «по расстоянию» и «фракции»
       появляются и пропадают, когда игроки двигаются и меняют фракцию. Изменение от плагина уходит в следующем кадре. -->
  <ReconcileMs>1000</ReconcileMs>

  <!-- Игроку без клиентского мода уведомления показываются обычными уведомлениями игры. Фигуры ему не рисуются. -->
  <FallbackNotifications>true</FallbackNotifications>

  <!-- Писать в лог каждый клиентский мод, приславший «я загрузился». -->
  <DiagnosticLogs>false</DiagnosticLogs>
</RenderConfig>
